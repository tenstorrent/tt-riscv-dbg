# cocotb testbench for tdr2axi (see doc/tdr2axi.md).
#
#   make                         # default CONFIG (axi4_a64_d64) with Verilator
#   make CONFIG=axil_a32_d32     # one configuration
#   make sim_all                 # every configuration
#   make SIM=vcs                 # Synopsys VCS instead of Verilator
#   make TESTCASE=single         # one test
#
# Needs cocotb (1.9), bender, and Verilator 5.036 or later (or VCS).

SIM           ?= verilator
TOPLEVEL_LANG  = verilog
TOPLEVEL       = tb_tdr2axi
MODULE         = test_tdr2axi
COCOTB_TEST_MODULES = $(MODULE)

COCOTB_HDL_TIMEUNIT      = 1ps
COCOTB_HDL_TIMEPRECISION = 1ps

# name: AXI_LITE AXI_ADDR_WIDTH AXI_DATA_WIDTH CLK_PERIOD_PS TCK_PERIOD_PS
CONFIGS := axi4_a64_d64 axi4_a64_d32 axi4_a32_d32 axil_a64_d64 axil_a64_d32 axil_a32_d32 \
           axi4_a64_d64_slowclk
cfg_axi4_a64_d64         := 0 64 64 1000 20000
cfg_axi4_a64_d32         := 0 64 32 1000 20000
cfg_axi4_a32_d32         := 0 32 32 1000 20000
cfg_axil_a64_d64         := 1 64 64 1000 20000
cfg_axil_a64_d32         := 1 64 32 1000 20000
cfg_axil_a32_d32         := 1 32 32 1000 20000
cfg_axi4_a64_d64_slowclk := 0 64 64 40000 20000

CONFIG ?= axi4_a64_d64
ifeq ($(filter $(CONFIG),$(CONFIGS)),)
  $(error unknown CONFIG '$(CONFIG)', use one of: $(CONFIGS))
endif
AXI_LITE       := $(word 1,$(cfg_$(CONFIG)))
AXI_ADDR_WIDTH := $(word 2,$(cfg_$(CONFIG)))
AXI_DATA_WIDTH := $(word 3,$(cfg_$(CONFIG)))
# Clock periods are read by the test, not compiled in
export CLK_PERIOD_PS := $(word 4,$(cfg_$(CONFIG)))
export TCK_PERIOD_PS := $(word 5,$(cfg_$(CONFIG)))

# The widths are compile-time parameters, so each configuration gets its own build
SIM_BUILD           := sim_build_$(SIM)_$(CONFIG)
COCOTB_RESULTS_FILE := results_$(SIM)_$(CONFIG).xml

ROOT  := $(abspath $(CURDIR)/../..)
FLIST := $(CURDIR)/$(SIM_BUILD)/sources.f

VERILOG_SOURCES = $(CURDIR)/tb_tdr2axi.sv
COMPILE_ARGS   += -f $(FLIST)

ifeq ($(SIM),verilator)
  COMPILE_ARGS += -GAXI_LITE=$(AXI_LITE) -GAXI_ADDR_WIDTH=$(AXI_ADDR_WIDTH) \
                  -GAXI_DATA_WIDTH=$(AXI_DATA_WIDTH)
  COMPILE_ARGS += --timing -Wno-fatal -Wno-lint -Wno-style -DCOMMON_CELLS_ASSERTS_OFF
  ifeq ($(WAVES),1)
    EXTRA_ARGS += --trace-fst --trace-structs
  endif
else ifeq ($(SIM),vcs)
  COMPILE_ARGS += -pvalue+$(TOPLEVEL).AXI_LITE=$(AXI_LITE) \
                  -pvalue+$(TOPLEVEL).AXI_ADDR_WIDTH=$(AXI_ADDR_WIDTH) \
                  -pvalue+$(TOPLEVEL).AXI_DATA_WIDTH=$(AXI_DATA_WIDTH)
  COMPILE_ARGS += -assert svaext
  SIM_ARGS     += -assert nopostproc
endif

include $(shell cocotb-config --makefiles)/Makefile.sim

# Filelist of the DUT and its dependencies, generated by bender before the build
$(FLIST):
	mkdir -p $(dir $@)
	cd $(ROOT) && bender script flist-plus -t tdr2axi \
	  -t tech_cells_generic:tech_cells_generic_exclude_deprecated > $@

$(SIM_BUILD)/Vtop.mk $(SIM_BUILD)/simv: $(FLIST)

# cocotb exits 0 even when a test fails, so check the results file
.PHONY: check
check:
	@test -f $(COCOTB_RESULTS_FILE) || (echo "ERROR: no $(COCOTB_RESULTS_FILE)" >&2; exit 1)
	@! grep -q -e '<failure' -e '<error' $(COCOTB_RESULTS_FILE) || \
	  (echo "ERROR: test failures in $(COCOTB_RESULTS_FILE)" >&2; exit 1)

.PHONY: sim_all
sim_all:
	rc=0; \
	for c in $(CONFIGS); do \
	  $(MAKE) sim CONFIG=$$c && $(MAKE) check CONFIG=$$c || rc=1; \
	done; \
	exit $$rc

clean::
	rm -rf sim_build_* results_*.xml dump.fst __pycache__
