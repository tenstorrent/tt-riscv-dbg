# SPDX-License-Identifier: Apache-2.0
#
# tdr2axi_axi_comb_path_formal: CHK-AXI-NO-COMB-PATH-SVA. tdr2axi_fv_top in a multiclock
# model: i_clk is a free clock on the global clock, i_axi_rsp and the cut DMI port are free
# at every step, and dmi_tdr_bridge is cut at its ports. AXI_ADDR_WIDTH = 16,
# AXI_DATA_WIDTH = 32, USE_AXI_LITE = 0 and 1. tdr2axi_fv_gclk_dly is read with the native
# frontend, which lowers $global_clock.
# Run from formal/ with make, which builds build/sources.f with bender.

[tasks]
prove_a4_d32 prove a4_d32
prove_al_d32 prove al_d32
cover_a4_d32 cover a4_d32
cover_al_d32 cover al_d32

# Cover depth: each i_clk cycle takes at least two steps; SYNC_STAGES + 1 reset cycles,
# three DMI writes, one cycle into dm_sba and a held request: 2 * (4 + 3 + 1 + 2) = 20
# steps, run to 40.
[options]
prove: mode prove
prove: timeout 3600
cover: mode cover
cover: depth 40
multiclock on

[engines]
prove: abc --keep-going pdr
cover: smtbmc yices

[script]
read_verilog -sv -formal tdr2axi_fv_gclk_dly.sv
a4_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=0 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_axi_comb_sva.sv tdr2axi_axi_comb_sva_bind.sv
al_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=1 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_axi_comb_sva.sv tdr2axi_axi_comb_sva_bind.sv
# The bridge's i_clk-side outputs become free inputs
cutpoint -blackbox
prep -flatten -top tdr2axi_fv_top
# The frontend lowers dm_sba's indexed part-select writes of be_mask to $shiftx cells, whose
# out-of-range bits are x, under a write mask that never selects those bits, and write_aiger
# rejects x. techmap maps every $shiftx here, and setundef then frees every undriven and x
# wire, which leaves every bit the mask selects unchanged.
techmap t:$shiftx
select -assert-none t:$shiftx
setundef -undriven -anyseq

[files]
sources.f ../build/sources.f
../tdr2axi_fv_gclk_dly.sv
../tdr2axi_fv_top.sv
../../sva/tdr2axi_axi_comb_sva.sv
../../sva/tdr2axi_axi_comb_sva_bind.sv
