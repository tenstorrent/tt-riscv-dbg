#
# tdr2axi_axi_mgr_formal: CHK-AXI-HANDSHAKE-SVA and CHK-AXI-ONE-OUTSTANDING-SVA on the
# i_clk side of tdr2axi (tdr2axi_fv_top), dmi_tdr_bridge cut at its ports. dm_csrs,
# dm_sba, the AXI adapter and tdr2axi.sv are as built; i_axi_rsp and the DMI port are free.
# AXI_ADDR_WIDTH = 16 with AXI_DATA_WIDTH = 32 and 64, each with USE_AXI_LITE = 0 and 1.
# Run from formal/ with make, which builds build/sources.f with bender.

[tasks]
prove_a4_d32 prove a4_d32
prove_a4_d64 prove a4_d64
prove_al_d32 prove al_d32
prove_al_d64 prove al_d64
cover_a4_d32 cover a4_d32
cover_a4_d64 cover a4_d64
cover_al_d32 cover al_d32
cover_al_d64 cover al_d64

# Cover depth: SYNC_STAGES + 1 reset cycles, one DMI write each of dmcontrol, sbcs and
# sbaddress0 or sbdata0, one cycle into dm_sba, a held request, its handshake and response,
# then a second access the same way: 4 + 3 + 1 + 3 + 1 + 6 = 18 cycles, run to 30.
[options]
prove: mode prove
prove: timeout 3600
cover: mode cover
cover: depth 30
multiclock off

[engines]
prove: abc --keep-going pdr
cover: smtbmc yices

[script]
a4_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=0 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 -G AXI_MGR_SVA=1 -G DMACTIVE_HOLD=1 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_axi_mgr_sva.sv tdr2axi_axi_resp_sva.sv tdr2axi_axi_resp_sva_bind.sv
a4_d64: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=0 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=64 -G AXI_MGR_SVA=1 -G DMACTIVE_HOLD=1 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_axi_mgr_sva.sv tdr2axi_axi_resp_sva.sv tdr2axi_axi_resp_sva_bind.sv
al_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=1 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 -G AXI_MGR_SVA=1 -G DMACTIVE_HOLD=1 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_axi_mgr_sva.sv tdr2axi_axi_resp_sva.sv tdr2axi_axi_resp_sva_bind.sv
al_d64: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=1 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=64 -G AXI_MGR_SVA=1 -G DMACTIVE_HOLD=1 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_axi_mgr_sva.sv tdr2axi_axi_resp_sva.sv tdr2axi_axi_resp_sva_bind.sv
# The bridge's i_clk-side outputs become free inputs
cutpoint -blackbox
prep -flatten -top tdr2axi_fv_top
# The frontend lowers dm_sba's indexed part-select writes of be_mask to $shiftx cells, whose
# out-of-range bits are x, under a write mask that never selects those bits, and write_aiger
# rejects x. techmap maps every $shiftx here, and setundef then frees every undriven and x
# wire, which leaves every bit the mask selects unchanged.
techmap t:$shiftx
select -assert-none t:$shiftx
setundef -undriven -anyseq

[files]
sources.f ../build/sources.f
../tdr2axi_fv_top.sv
../../sva/tdr2axi_axi_mgr_sva.sv
../../sva/tdr2axi_axi_resp_sva.sv
../../sva/tdr2axi_axi_resp_sva_bind.sv
