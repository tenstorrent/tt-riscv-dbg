# SPDX-License-Identifier: Apache-2.0
#
# tdr2axi_bridge_formal: CHK-TDR-OP-DECODE-SVA, CHK-TDR-STATUS-SVA and the TCK side of
# CHK-TDR-DM-RESP-CODES-SVA (status 2 never reaches o_dmi_tdr). dmi_tdr_bridge alone on
# TCK (tdr2axi_fv_bridge_top) with the three cdc_2phase_clearable outputs it reads cut free.
# Full width: the TDR is 41 bits and the bridge has no width parameter.
# Run from formal/ with make, which builds build/sources.f with bender.

[tasks]
prove
cover

# Cover depth: one reset cycle, an update, the request offered and accepted, a wait, the
# response and a capture: 7 cycles; a busy status raised and cleared with op 3 adds 3,
# run to 20.
[options]
prove: mode prove
prove: timeout 3600
cover: mode cover
cover: depth 20
multiclock off

[engines]
prove: abc --keep-going pdr
cover: smtbmc yices

[script]
read_slang -D FORMAL --top tdr2axi_fv_bridge_top -f sources.f tdr2axi_fv_bridge_top.sv tdr2axi_bridge_sva.sv tdr2axi_bridge_sva_bind.sv
# The request CDC's ready and the response CDC's valid and payload become free inputs. The
# frontend cannot blackbox cdc_2phase_clearable, whose payload is a type parameter, so the
# cut is on the three nets; the CDCs' other outputs drive nothing in this top.
select -assert-count 3 tdr2axi_fv_bridge_top/w:u_dut.dmi_req_ready tdr2axi_fv_bridge_top/w:u_dut.dmi_resp_valid tdr2axi_fv_bridge_top/w:u_dut.dmi_resp
cutpoint tdr2axi_fv_bridge_top/w:u_dut.dmi_req_ready tdr2axi_fv_bridge_top/w:u_dut.dmi_resp_valid tdr2axi_fv_bridge_top/w:u_dut.dmi_resp
prep -flatten -top tdr2axi_fv_bridge_top

[files]
sources.f ../build/sources.f
../tdr2axi_fv_bridge_top.sv
../../sva/tdr2axi_bridge_sva.sv
../../sva/tdr2axi_bridge_sva_bind.sv
