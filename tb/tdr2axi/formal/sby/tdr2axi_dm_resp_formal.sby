#
# tdr2axi_dm_resp_formal: CHK-TDR-DM-RESP-CODES-SVA on the i_clk side, every DMI response
# of dm_csrs carries code 0 or 3. tdr2axi_fv_top with dmi_tdr_bridge cut at its ports, so
# the DMI request, DMI writes of dmcontrol included, and the response ready are free;
# dm_csrs, dm_sba and the AXI adapter are as built and i_axi_rsp is free, any response
# code included. AXI_ADDR_WIDTH = 16, AXI_DATA_WIDTH = 32, USE_AXI_LITE = 0 and 1.
# Run from formal/ with make, which builds build/sources.f with bender.

[tasks]
prove_a4_d32 prove a4_d32
prove_al_d32 prove al_d32
cover_a4_d32 cover a4_d32
cover_al_d32 cover al_d32

# Cover depth: SYNC_STAGES + 1 reset cycles, DMI writes that start an access, and a DMI
# access while sbbusy that answers busy: 4 + 3 + 2 = 9 cycles, run to 25.
[options]
prove: mode prove
prove: timeout 3600
cover: mode cover
cover: depth 25
multiclock off

[engines]
prove: abc --keep-going pdr
cover: smtbmc yices

[script]
a4_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=0 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_dm_resp_sva.sv tdr2axi_dm_resp_sva_bind.sv
al_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=1 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_dm_resp_sva.sv tdr2axi_dm_resp_sva_bind.sv
# The bridge's i_clk-side outputs become free inputs
cutpoint -blackbox
prep -flatten -top tdr2axi_fv_top

[files]
sources.f ../build/sources.f
../tdr2axi_fv_top.sv
../../sva/tdr2axi_dm_resp_sva.sv
../../sva/tdr2axi_dm_resp_sva_bind.sv
