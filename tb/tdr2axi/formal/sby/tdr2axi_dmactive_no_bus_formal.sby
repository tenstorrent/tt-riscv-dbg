#
# tdr2axi_dmactive_no_bus_formal: CHK-DM-DMACTIVE-NO-BUS-SVA alone. The cut of
# tdr2axi_dmactive_inflight_formal: tdr2axi_fv_top on i_clk only, dmi_tdr_bridge cut at its
# ports, DMI writes of dmcontrol free, i_axi_rsp free.
# AXI_ADDR_WIDTH = 16 with AXI_DATA_WIDTH = 32 and 64, each with USE_AXI_LITE = 0 and 1.
# Run from formal/ with make, which builds build/sources.f with bender.

[tasks]
bmc_a4_d32 bmc a4_d32
bmc_a4_d64 bmc a4_d64
bmc_al_d32 bmc al_d32
bmc_al_d64 bmc al_d64
prove_a4_d32 prove a4_d32
prove_a4_d64 prove a4_d64
prove_al_d32 prove al_d32
prove_al_d64 prove al_d64
cover_a4_d32 cover a4_d32
cover_a4_d64 cover a4_d64
cover_al_d32 cover al_d32
cover_al_d64 cover al_d64

# Depth: SYNC_STAGES + 1 reset cycles, DMI writes of dmcontrol = 1 and = 0, a DMI write
# that starts an access and one cycle into dm_sba: 4 + 2 + 1 + 1 = 8 cycles, run to 25.
[options]
bmc: mode bmc
bmc: depth 25
prove: mode prove
prove: timeout 3600
cover: mode cover
cover: depth 25
multiclock off

[engines]
bmc: smtbmc --keep-going yices
prove: abc --keep-going pdr
cover: smtbmc yices

[script]
a4_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=0 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_dmactive_no_bus_sva.sv tdr2axi_dmactive_no_bus_sva_bind.sv
a4_d64: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=0 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=64 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_dmactive_no_bus_sva.sv tdr2axi_dmactive_no_bus_sva_bind.sv
al_d32: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=1 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=32 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_dmactive_no_bus_sva.sv tdr2axi_dmactive_no_bus_sva_bind.sv
al_d64: read_slang -D FORMAL --top tdr2axi_fv_top -G USE_AXI_LITE=1 -G AXI_ADDR_WIDTH=16 -G AXI_DATA_WIDTH=64 --blackboxed-module dmi_tdr_bridge -f sources.f tdr2axi_fv_top.sv tdr2axi_dmactive_no_bus_sva.sv tdr2axi_dmactive_no_bus_sva_bind.sv
# The bridge's i_clk-side outputs become free inputs
cutpoint -blackbox
prep -flatten -top tdr2axi_fv_top

[files]
sources.f ../build/sources.f
../tdr2axi_fv_top.sv
../../sva/tdr2axi_dmactive_no_bus_sva.sv
../../sva/tdr2axi_dmactive_no_bus_sva_bind.sv
